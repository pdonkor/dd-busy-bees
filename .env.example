# Copy to .env.local for local development. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://localhost:3000

# Supabase Auth > Hooks > Send SMS: the hook secret (starts with v1,whsec_)
SEND_SMS_HOOK_SECRET=
# Arkesel SMS API key. Leave blank in development to print SMS to the server log.
ARKESEL_API_KEY=
SMS_SENDER_ID=BusyBees

# Copy to .env.local for local development, and set the same names in Vercel
# (Project > Settings > Environment Variables). Never commit real values.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# The app's public address, e.g. https://app.ddbusybees.com (no trailing slash)
APP_URL=http://localhost:3000

# Supabase Auth > Hooks > Send SMS: the hook secret (starts with v1,whsec_)
SEND_SMS_HOOK_SECRET=
# Arkesel SMS API key. Leave blank in development to print SMS to the server log.
ARKESEL_API_KEY=
SMS_SENDER_ID=BusyBees

# Signs the rotating staff clock-in QR code. Generate with: openssl rand -base64 48
CLOCK_QR_SECRET=
# Protects the scheduled jobs (daily SMS summary, termly invoices, fee reminders).
# Vercel Cron sends it automatically once it is set. Generate with: openssl rand -base64 32
CRON_SECRET=

# Paystack (Settings > API Keys & Webhooks). Use sk_test_… until the account is live.
PAYSTACK_SECRET_KEY=
# Paystack needs an email address; parents who only have a phone get <phone>@<this domain>.
PAYSTACK_PLACEHOLDER_EMAIL_DOMAIN=parents.ddbusybees.com

# Optional: Cloudflare Turnstile bot check on the public enquiry form.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional: which school the public enquiry form belongs to (defaults to the only school).
PUBLIC_SCHOOL_ID=
